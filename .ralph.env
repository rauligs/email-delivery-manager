# Ralph configuration. Sourced by ./ralph.sh at startup.
# Edit any value here to change settings persistently - no need to re-run setup.

# Developer and QA must be different providers: claude, gemini, codex, or glm.
# glm runs the claude CLI against z.ai via the claude-glm wrapper (install-claude-glm.sh).
DEVELOPER_AGENT=codex
QA_AGENT=claude

# Leave model empty to use the provider CLI default/latest model for your
# installed CLI and account. Set a model id only when you need to override/pin.
DEVELOPER_MODEL=''
QA_MODEL=''

# Codex developer runs may need local resources such as Docker for verification.
CODEX_SANDBOX=danger-full-access

# Codex reasoning effort split:
# - Manual Codex planning, PRD, issue creation, and QA use high reasoning.
# - Codex implementation and QA fix runs use medium reasoning.
CODEX_DEVELOPER_REASONING_EFFORT=medium
CODEX_QA_REASONING_EFFORT=high
CODEX_PLANNING_REASONING_EFFORT=high

# Claude effort split:
# - Manual Claude planning, PRD, issue creation, and QA use high effort.
# - Claude implementation and QA fix runs use medium effort.
CLAUDE_DEVELOPER_EFFORT=medium
CLAUDE_QA_EFFORT=high
CLAUDE_PLANNING_EFFORT=high

# Repo-level verification contract. Ralph uses this before committing.
# Keep this script deterministic and make it run every required project check.
VERIFY_CMD=./scripts/verify.sh

# Project layout: where the plan, the issue files, and the manual-QA scenarios
# live. If you change these later, re-run the installer so the generated docs
# and skills prose is re-rendered to match (the scripts pick them up directly).
RALPH_PRD_DIR=prd
RALPH_PRD_FILE=prd/PRD.md
RALPH_ISSUES_DIR=issues
RALPH_QA_DIR=qa-manual-verification

# Agent-facing project context: the ONE file describing this project for the
# agents (folder map, skill routing by name, how to run things). Scaffolded as
# a suggestion on install when missing; yours to edit, never overwritten.
# ralph.sh injects it into every developer/QA/planning prompt at runtime.
RALPH_CONTEXT_FILE=CONTEXT.md

# Docker disclosure for verification: auto, 1, or 0.
# auto notes Docker when verify scripts or compose files indicate it.
ALLOW_DOCKER=auto

# Timeout for each developer, QA, and QA-fix agent CLI call.
RALPH_AGENT_TIMEOUT_SECONDS=3600

# Optional: run a command on progress events (run-start, issue-closed, run-stopped, ...).
# See AI-WORKFLOW.md (Observability) for example notifiers (Slack, desktop, bell).
# RALPH_PROGRESS_HOOK=/path/to/notify.sh

# Automatic developer fix attempts after a failed per-issue QA verdict.
MAX_QA_FIXES=3

# Maximum per-issue QA stdin payload bytes sent to any reviewer CLI.
QA_DIFF_MAX_BYTES=900000

# Full comprehensive QA discovery reviews before scoped (delta-only) re-review.
# The first N rounds review the whole issue diff; later rounds verify fixes plus
# regressions in the delta only. Increase MAX_QA_FIXES too for more scoped rounds.
QA_FULL_REVIEW_ROUNDS=2

# Advanced QA override. Leave empty to use QA_AGENT/QA_MODEL. If set, this
# command must accept an issue's diff on stdin and end with PASS or FAIL.
QA_CMD=''

# Plan-critique panel (opt-in). When PANEL_ENABLED=1 the remote run reviews prd/PRD.md
# with a multi-lens panel before decomposing; ./ralph.sh --review-plan runs it any time.
# PANEL_AGENT defaults to QA_AGENT; PANEL_BLOCKING=1 makes a remote NEEDS CHANGES stop
# before decompose (advisory by default).
PANEL_ENABLED=0
PANEL_AGENT=claude
PANEL_MODEL=''
PANEL_LENSES=architecture\,security\,ops\,testability
PANEL_BLOCKING=0

# Plan scope-size gate (on by default). Before --decompose, one agent call judges whether
# prd/PRD.md is a single shippable slice; an over-scoped plan hard-stops before the run so
# you split big features into multiple sequential plans (behind a feature flag) and keep
# each run a limited, reviewable slice. Set to 0 to skip the gate.
PLAN_SCOPE_GATE=1

# Other tunables:
# MAX_ITERATIONS=20
# PERMISSION_MODE=acceptEdits  # Claude developer only
